#Requires -Version 7.0
<#
.SYNOPSIS
    Alternate-extension example (psxml) — returns raw XML, no JSON envelope.

.DESCRIPTION
    Files with the psxml, posh, or psapi extension bypass the
    `{ exitCode, output, error }` JSON envelope: the server forwards
    the script's stdout verbatim with a Content-Type chosen from
    `ScriptExtensionMap`.

        psxml  -> text/xml; charset=utf-8
        posh   -> text/html; charset=utf-8
        psapi  -> application/xml; charset=utf-8

    When `ExecutionMode = 'InProcess'` the server injects a
    `ConvertTo-PoshApiXml` helper into the runspace (legacy PoSH Server
    `New-PoSHAPIXML` shape). Under `Subprocess` (default), the helper
    isn't visible inside `pwsh.exe`, so this script falls back to a
    hand-rolled here-string. Same response either way.

.EXAMPLE
    $xml = Invoke-WebRequest -Uri 'http://localhost/api-status.psxml' `
              -Headers @{ 'X-Api-Key' = 'your-key' }
    [xml] $doc = $xml.Content
    $doc.Result.Items.Item.Hostname
#>
param()

# Empty param() block above anchors the comment-based help so
# Get-ScriptMetadata (F7) + Build-OpenApiSpec (F10) can extract the synopsis.

$ErrorActionPreference = 'Stop'

# Central config — the FQDN reported here is the deployment-level
# identifier, distinct from $env:COMPUTERNAME which is the underlying VM.
. (Join-Path $PSScriptRoot '..\globalvars.ps1')

$items = @(
    @{ Hostname     = $env:COMPUTERNAME }
    @{ PoshServer   = $PoshServerFqdn }
    @{ Domain       = $DomainDnsSuffix }
    @{ TimeUtc      = (Get-Date).ToUniversalTime().ToString('o') }
    @{ PSVersion    = $PSVersionTable.PSVersion.ToString() }
    @{ PoshRequests = if ($null -ne $requestsTotal) { [System.Threading.Interlocked]::Read($requestsTotal) } else { 0 } }
)

if (Get-Command ConvertTo-PoshApiXml -ErrorAction SilentlyContinue) {
    # InProcess mode — server-injected helper produces compact, schema-stable XML.
    ConvertTo-PoshApiXml -Code 1 -Message 'OK' -Items $items
} else {
    # Subprocess mode — hand-rolled equivalent.
    $itemXml = $items | ForEach-Object {
        $inner = ($_.GetEnumerator() | ForEach-Object { "    <$($_.Key)>$($_.Value)</$($_.Key)>" }) -join "`n"
        "  <Item>`n$inner`n  </Item>"
    }
    @"
<?xml version="1.0" encoding="utf-8"?>
<Result>
  <Code>1</Code>
  <Message>OK</Message>
  <Items>
$($itemXml -join "`n")
  </Items>
</Result>
"@
}
