# ---------------------------------------------------------------------------
# Runtime logs — machine-specific, not tracked in repo
# ---------------------------------------------------------------------------
logs/*.log

# Keep the logs/ directory itself via .gitkeep
!logs/.gitkeep

# ---------------------------------------------------------------------------
# Secrets — keep encrypted credential files out of git
# ---------------------------------------------------------------------------
# globalvars.ps1 is THE central config and ships in the repo. After running
# tools\New-PoshAesKey.ps1 the $key array contains your per-install
# random AES key — do NOT commit that personalised version back upstream.
encrypted_pw/encryptedString_*.txt

# Keep the encrypted_pw/ directory itself so a fresh clone has the layout.
!encrypted_pw/.gitkeep

# ---------------------------------------------------------------------------
# Runtime configuration — generated per install by tools\Initialize-PoshConfig.ps1
# ---------------------------------------------------------------------------
# config.psd1 is the runtime source of truth for the posh server. It is
# generated locally from the inline $cfg defaults in Start-WebServer.ps1
# and contains personalised values (ports, IPs, API-key labels, paths) —
# never commit it.
config.psd1
config.psd1.bak.*

# Editor + tooling rotate backups next to the file being edited.
globalvars.ps1.bak.*

# ---------------------------------------------------------------------------
# Project-specific exclusions
# ---------------------------------------------------------------------------
AGENTS.md
CONTEXT.md
webroot/restart-comfyui-graceful.ps1

# ---------------------------------------------------------------------------
# Windows
# ---------------------------------------------------------------------------
Thumbs.db
desktop.ini
$RECYCLE.BIN/
